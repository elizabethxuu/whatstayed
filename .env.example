# Your Anthropic API key, from console.anthropic.com
ANTHROPIC_API_KEY=

# Postgres connection string. On Vercel, adding Neon under Storage sets this for you.
# Leave empty locally to use the built-in PGlite database in .data/
# DATABASE_URL=

# Optional: a different Claude model
# WHATSTAYED_MODEL=claude-sonnet-5-5
